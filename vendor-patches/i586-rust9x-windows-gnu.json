{
  "abi-return-struct-as-int": true,
  "arch": "x86",
  "archive-format": "coff",
  "binary-format": "coff",
  "cpu": "pentium4",
  "crt-static-allows-dylibs": true,
  "crt-static-respected": true,
  "data-layout": "e-m:x-p:32:32-p270:32:32-p271:32:32-p272:64:64-i64:64-i128:128-f80:128-n8:16:32-a:0:32-S32",
  "debuginfo-kind": "pdb",
  "dll-prefix": "",
  "dll-suffix": ".dll",
  "dll-tls-export": false,
  "dynamic-linking": true,
  "emit-debug-gdb-scripts": false,
  "env": "msvc",
  "exe-suffix": ".exe",
  "has-thread-local": true,
  "is-like-msvc": true,
  "is-like-windows": true,
  "linker-flavor": "msvc",
  "llvm-target": "i586-pc-windows-msvc",
  "max-atomic-width": 64,
  "metadata": {
    "description": "32-bit MSVC (Windows 9x+)",
    "host_tools": false,
    "std": true,
    "tier": 3
  },
  "no-default-libraries": false,
  "os": "windows",
  "requires-uwtable": false,
  "rustc-abi": "x86-sse2",
  "split-debuginfo": "packed",
  "staticlib-prefix": "",
  "staticlib-suffix": ".lib",
  "target-family": ["windows"],
  "target-pointer-width": 32,
  "vendor": "rust9x"
}
